APP_NAME="Axiom Maintenance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Axiom Maintenance ---
# First admin login (created by `php artisan db:seed`)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Rent Manager 12 API (same login as hbcinvestor.com). Leave sync off until the login is in.
RM_API_BASE_URL=https://axiom.api.rentmanager.com
RM_API_USER=
RM_API_PASSWORD=
RM_SYNC_ENABLED=false

# Shared secret the axiom-properties.com form sends in the X-Axiom-Key header
INTAKE_API_KEY=

# Texting. Use SMS_DRIVER=log until Twilio's 10DLC registration is approved.
SMS_DRIVER=log
SMS_FROM_NUMBER=
OFFICE_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=true

# Cloudflare R2 for photos
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=axiom-maintenance-photos
PHOTO_PURGE_DAYS=30

# AI triage (Claude). Keyword rules are used when this is off.
AI_TRIAGE_ENABLED=false
ANTHROPIC_API_KEY=
# Reads receipt photos automatically once the key above is set
AI_RECEIPTS_ENABLED=true
AI_TRIAGE_MODEL=claude-opus-5-5
AI_TRIAGE_EFFORT=low
AI_MIN_CONFIDENCE=0.7
